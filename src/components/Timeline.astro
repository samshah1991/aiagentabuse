---
import Badge from './Badge.astro';
import { fmtDate } from '../lib/site';
interface Props { incidents: any[]; catName: Record<string, string> }
const { incidents, catName } = Astro.props;
// Group by month, newest first (incidents arrive sorted newest first).
const groups: { key: string; label: string; items: any[] }[] = [];
for (const i of incidents) {
  const key = i.date.slice(0, 7);
  let g = groups.find((x) => x.key === key);
  if (!g) {
    g = { key, label: new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }), items: [] };
    groups.push(g);
  }
  g.items.push(i);
}
---
<ol class="timeline">
  {groups.map((g) => (
    <li class="tl-month">
      <h3 class="tl-month-label">{g.label}</h3>
      <ol class="tl-items">
        {g.items.map((i) => (
          <li class={`tl-item tl-${i.track}`}>
            <time datetime={i.date}>{fmtDate(i.date)}</time>
            <h4><a href={`/incidents/${i.id}/`}>{i.title}</a></h4>
            <div class="badges">
              <Badge kind="track" value={i.track} label={i.track === 'cause' ? 'Agent as cause' : 'Agent as target'} />
              <Badge kind="plain" value={i.category} label={catName[i.category]} />
              <Badge kind="severity" value={i.severity} label={`Severity: ${i.severity}`} />
              {i.verification_status === 'draft' && <Badge kind="status" value="draft" label="Draft: unverified" />}
            </div>
          </li>
        ))}
      </ol>
    </li>
  ))}
</ol>
