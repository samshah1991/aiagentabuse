---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props { title: string; description: string; searchable?: boolean; noindex?: boolean }
const { title, description, searchable = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const nav = [
  ['/incidents/', 'Incidents'], ['/defenses/', 'Defenses'], ['/taxonomy/', 'Taxonomy'],
  ['/method/', 'Method'], ['/submit/', 'Submit'], ['/about/', 'About'],
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap.xml" />
  <slot name="head" />
  {/*
    TODO: Cloudflare Web Analytics (cookie-free). Disabled until you decide to enable it.
    To enable, add the beacon snippet from the Cloudflare dashboard here, update the
    privacy page, and add static.cloudflareinsights.com / cloudflareinsights.com to the CSP in public/_headers.
  */}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">AI<span>agent</span>Abuse</a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([href, label]) => (
            <li><a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap" {...(searchable ? { 'data-pagefind-body': '' } : {})}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p><strong>Not legal advice.</strong> Information on this site is provided for general education and security awareness. It is not legal, compliance, or professional advice. See the <a href="/disclaimer/">disclaimer</a>.</p>
      <p>Content <a href="/license/">CC BY 4.0</a> · Code <a href="/license/">MIT</a> · <a href="/privacy/">Privacy</a> (no cookies, no tracking) · <a href="/method/">Corrections</a></p>
    </div>
  </footer>
</body>
</html>
