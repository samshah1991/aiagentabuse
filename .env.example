# Placeholders only. Never commit real values. Copy to .env for local use.
# The site builds without any of these; they are reserved for later phases.

# Site URL used for canonical links (also set in astro.config.mjs).
PUBLIC_SITE_URL=https://aiagentabuse.com

# TODO: Cloudflare Web Analytics beacon token (cookie-free). Leave empty to keep analytics off.
PUBLIC_CF_ANALYTICS_TOKEN=

# TODO: newsletter provider (Phase 2). Leave empty until a provider is chosen.
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=

# Evidence agent (docs/evidence-method.md). Add ANTHROPIC_API_KEY as a GitHub Actions secret; never commit it.
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: $10 per run, $50 per month. Kill switch: set to "on" to stop all runs.
AGENT_RUN_CAP_USD=
AGENT_MONTH_CAP_USD=
AGENT_KILL_SWITCH=
